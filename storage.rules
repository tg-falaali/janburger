rules_version = '2';

// Jan Burger: the pictures of menu layers that staff upload from the
// dashboard. Anyone may see them (the menu shows them); only a signed-in
// user may add, replace or remove one, and only an image under 3 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /layers/{file} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    match /{everything=**} {
      allow read, write: if false;
    }
  }
}
